# VajraClaw Heartbeat Server Environment Configuration
# 請將此檔案複製並重新命名為 .env，然後填入真實資料

# 資料庫連線設定 (MariaDB on NAS)
# 因為我們走 Tailscale，所以可以直接填 NAS 的 Tailscale IP (例如 100.x.x.x)
# 或是原本的內部 IP 192.168.100.128 (如果您的路由設定有通)
DB_HOST=100.71.38.35
DB_PORT=3308
DB_USER=topuser
DB_PASS=opeN#000021
DB_NAME=top_db

# Lemon Squeezy 設定
# 請在 Lemon Squeezy 後台 -> Settings -> Webhooks 取得 Signing Secret
LEMON_SQUEEZY_SECRET=your_webhook_secret

# JWT 簽章設定 (用於核發 24 小時有效期的動態 Token 給 Agent)
JWT_SECRET=generate_a_random_secure_string_here
